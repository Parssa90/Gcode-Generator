# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Voice Transcription (optional — for server-side transcription) ────────────
OPENAI_API_KEY=sk-...

# ─── Google OAuth (for Gmail + Google Calendar integration) ───────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ─── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# ─── Laptop Agent ──────────────────────────────────────────────────────────────
LAPTOP_AGENT_URL=ws://localhost:8765
