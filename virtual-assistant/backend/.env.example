# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Outlook / Office 365 Email ───────────────────────────────────────────────
# Works with: Outlook.com, Office 365, Exchange Online
# If MFA is ON → generate an App Password at:
#   account.microsoft.com → Security → Advanced security → App passwords
OUTLOOK_EMAIL=you@company.com
OUTLOOK_PASSWORD=your-password-or-app-password

# ─── Voice Transcription (optional — for server-side transcription) ────────────
OPENAI_API_KEY=sk-...

# ─── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# ─── Microsoft Teams Bot ──────────────────────────────────────────────────────
# Full setup guide: TEAMS_SETUP.md
TEAMS_BOT_APP_ID=          # Azure Bot → Microsoft App ID
TEAMS_BOT_APP_PASSWORD=    # Azure Bot → Client Secret
TEAMS_TENANT_ID=           # Azure AD → Tenant ID
TEAMS_CLIENT_ID=           # Same as BOT_APP_ID
TEAMS_CLIENT_SECRET=       # Same as BOT_APP_PASSWORD
TEAMS_ORGANIZER_USER_ID=   # Azure AD → Users → your Object ID

# ─── Laptop Agent ──────────────────────────────────────────────────────────────
LAPTOP_AGENT_URL=ws://localhost:8765
